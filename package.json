{
	"name": "directus-extension-phone-field",
	"description": "Phone number field for Directus: country selector, as-you-type formatting, E.164 storage and server-side validation.",
	"icon": "phone",
	"version": "1.1.0",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MrCasquette/directus-extension-phone-field.git"
	},
	"homepage": "https://github.com/MrCasquette/directus-extension-phone-field#readme",
	"bugs": {
		"url": "https://github.com/MrCasquette/directus-extension-phone-field/issues"
	},
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-bundle"
	],
	"type": "module",
	"files": [
		"dist"
	],
	"directus:extension": {
		"type": "bundle",
		"path": {
			"app": "dist/app.js",
			"api": "dist/api.js"
		},
		"entries": [
			{
				"type": "interface",
				"name": "phone-interface",
				"source": "src/phone-interface/index.ts"
			},
			{
				"type": "display",
				"name": "phone-display",
				"source": "src/phone-display/index.ts"
			},
			{
				"type": "hook",
				"name": "phone-hook",
				"source": "src/phone-hook/index.ts"
			},
			{
				"type": "endpoint",
				"name": "phone-endpoint",
				"source": "src/phone-endpoint/index.ts"
			}
		],
		"host": "^12.0.0"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"validate": "directus-extension validate",
		"add": "directus-extension add",
		"type-check": "vue-tsc --noEmit",
		"test": "vitest run"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "18.0.5",
		"@directus/types": "^17.0.0",
		"@directus/validation": "^3.0.5",
		"country-flag-emoji-polyfill": "^0.1.10",
		"libphonenumber-js": "^1.13.14",
		"typescript": "^6.0.3",
		"vitest": "^5.0.2",
		"vue": "^3.5.24",
		"vue-i18n": "^11.4.12",
		"vue-tsc": "^3.3.11",
		"zod": "^4.6.5"
	}
}
